{$DEMO_HOST} {
	encode gzip
	request_body {
		max_size 85MB
	}
	# no access log: we do not keep visitor IPs or paths
	log {
		output discard
	}
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy app:7860 {
		transport http {
			read_timeout 20m
		}
	}
}
